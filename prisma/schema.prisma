// Money Playground — database schema
// Dev uses SQLite for zero-config setup. For production, switch the
// datasource provider to "postgresql" and point DATABASE_URL at Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- NextAuth models ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // App-specific profile fields used for wealth comparison.
  birthYear     Int?
  country       String?   @default("UK")
  // GB region (ONS name, e.g. "London", "South East") for regional comparison.
  region        String?

  accounts Account[]
  sessions Session[]
  holdings Holding[]
  assets   Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- App models ----

model Holding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  shares    Float
  // Optional: what the user paid per share, for cost-basis / gain display.
  costBasis Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per symbol per user; adding more shares updates the row.
  @@unique([userId, symbol])
}

// Non-stock assets: property, pensions, cash, and anything else.
// "value" is the gross value in GBP; "debt" is any liability (e.g. mortgage).
// Net contribution to wealth = value - debt.
model Asset {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "property" | "pension" | "cash" | "other"
  name      String
  value     Float
  debt      Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
